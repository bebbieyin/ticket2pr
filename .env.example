# Ticket2PR local configuration example.
# Copy to .env and fill values for local development.
# Do not commit real tokens or secrets.

# ClickUp
CLICKUP_TOKEN=
CLICKUP_WEBHOOK_SECRET=
CLICKUP_WORKSPACE_ID=
CLICKUP_TEMPLATE_DOC_URL=
CLICKUP_TASK_TYPE_FIELD_ID=
CLICKUP_TARGET_BRANCH_FIELD_ID=
CLICKUP_GITHUB_REVIEWER_FIELD_ID=
CLICKUP_PROBLEM_STATEMENT_FIELD_ID=
CLICKUP_EXPECTED_BEHAVIOR_FIELD_ID=
CLICKUP_CURRENT_BEHAVIOR_FIELD_ID=
CLICKUP_CONTEXT_OR_REPRO_STEPS_FIELD_ID=
CLICKUP_RELEVANT_LINKS_FIELD_ID=
CLICKUP_ACCEPTANCE_CRITERIA_FIELD_ID=
CLICKUP_TEST_EXPECTATIONS_FIELD_ID=

# ClickUp status names
CLICKUP_IN_DEVELOPMENT_STATUS=
CLICKUP_IN_REVIEW_STATUS=
CLICKUP_COMPLETE_STATUS=

# GitHub
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BASE_BRANCH=
GH_PAT_TOKEN=

# GitHub Actions workflow
GITHUB_WORKFLOW_REF=main
GITHUB_CHANGE_WORKFLOW_FILE=

# Webhook runtime
WEBHOOK_DEDUPE_TTL_SECONDS=86400

# Coding agent
CODING_AGENT_PROVIDER=openai

# OpenAI provider
OPENAI_API_KEY=

# Optional future providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
